{
  "name": "taskforge",
  "private": true,
  "type": "module",
  "workspaces": ["packages/*", "apps/*"],
  "engines": { "node": ">=22" },
  "scripts": {
    "dev:api": "npm run dev -w @taskforge/api",
    "dev:web": "npm run dev -w @taskforge/web",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "eslint": "^10.15.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.74.0"
  }
}
